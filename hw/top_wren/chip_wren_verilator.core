name: "lowrisc:systems:chip_wren_verilator:0.1"
description: "Minimal wren toplevel for simulation with Verilator"
filesets:
  files_sim_verilator:
    depend:
      - lowrisc:systems:top_wren:0.1
      - lowrisc:prim_generic:all
      - lowrisc:dv_dpi_c:uartdpi
      - lowrisc:dv_dpi_sv:uartdpi
    files:
      - rtl/chip_wren_verilator.sv: { file_type: systemVerilogSource }
      - rtl/chip_wren_verilator_main.cc: { file_type: cppSource }

parameters:
  SramInitFile:
    datatype: str
    description: VMEM image (32-bit words) backdoor-loaded into the code/data SRAM.
    paramtype: vlogparam

targets:
  default: &default_target
    filesets:
      - files_sim_verilator
    toplevel: chip_wren_verilator
    tools:
      verilator:
        mode: cc
        verilator_options:
          - "--no-timing"
          - "-Wno-fatal"

  sim:
    <<: *default_target
    default_tool: verilator

  lint:
    <<: *default_target
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wno-fatal"
